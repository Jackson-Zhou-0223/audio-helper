# Copy this file to .env and fill in real keys locally.
# Empty values are expected in the repo template. Health check must work without keys.

# Bailian (Beijing)
BAILIAN_API_KEY=
BAILIAN_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_ASR_MODEL=qwen3-asr-flash
BAILIAN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_TTS_MODEL=qwen3-tts-flash
BAILIAN_TTS_VOICE=Cherry
BAILIAN_TTS_LANGUAGE=Chinese

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Amap Web service key
AMAP_API_KEY=
AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
AMAP_AROUND_URL=https://restapi.amap.com/v3/place/around

# App
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8003
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
FFPROBE_PATH=
